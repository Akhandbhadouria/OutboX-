# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
DATABASE_URL=postgresql://reachinbox:reachinbox@localhost:5432/reachinbox

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Elasticsearch ────────────────────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ─── Session ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
SESSION_SECRET=replace_with_a_secure_64_char_secret

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# ─── Ethereal SMTP ────────────────────────────────────────────────────────────
# Run: npx ts-node apps/api/src/scripts/create-ethereal.ts to generate
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
ETHEREAL_USER=
ETHEREAL_PASS=

# ─── Slack OAuth ──────────────────────────────────────────────────────────────
# Create a Slack app at: https://api.slack.com/apps
# Redirect URL: http://localhost:3001/api/slack/callback
# Required Bot Token Scopes: chat:write, channels:read, incoming-webhook
# Required User Token Scopes: (none required)
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_CALLBACK_URL=http://localhost:3001/api/slack/callback
# Generate with: openssl rand -hex 32
SLACK_TOKEN_ENCRYPTION_KEY=replace_with_a_32_byte_hex_key

# ─── Worker configuration ─────────────────────────────────────────────────────
WORKER_CONCURRENCY=5
MIN_SEND_INTERVAL_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# ─── Campaign limits ──────────────────────────────────────────────────────────
MAX_RECIPIENTS_PER_CAMPAIGN=10000
MAX_UPLOAD_SIZE_MB=10

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
